# Backend REST base (fans-tech-backend)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Chat WebSocket gateway (when the backend chat gateway lands)
NEXT_PUBLIC_WS_URL=http://localhost:3000
# Toggle mock data (no backend needed). Set to "false" to hit the real API.
NEXT_PUBLIC_USE_MOCKS=true

# --- Web3 (Phase 2) — Web3Auth (sapphire_devnet) + Biconomy smart account, Eth Sepolia ---
NEXT_PUBLIC_WEB3_ENABLED=false
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet
NEXT_PUBLIC_WEB3AUTH_VERIFIER=fanstech-dev
NEXT_PUBLIC_WEB3AUTH_SUB_VERIFIER=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_BICONOMY_PAYMASTER_KEY=
# Fans.tech contract addresses (see fans-tech-contracts/deployments/ethereum-sepolia)
NEXT_PUBLIC_FANS_ADDRESS=
NEXT_PUBLIC_CLUB_FACTORY_ADDRESS=
NEXT_PUBLIC_FANS_SWAP_ADDRESS=
NEXT_PUBLIC_FEE_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_STAKING_FANS_ADDRESS=
NEXT_PUBLIC_STAKING_LP_ADDRESS=
NEXT_PUBLIC_CLUB_KEY_BEACON_ADDRESS=
