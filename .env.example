# Backend REST base (fanhatch-backend)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Chat WebSocket gateway (when the backend chat gateway lands)
NEXT_PUBLIC_WS_URL=http://localhost:3000
# Toggle mock data (no backend needed). Set to "false" to hit the real API.
NEXT_PUBLIC_USE_MOCKS=true

NEXT_PUBLIC_WEB3_ENABLED=false
# WalletConnect Cloud project id (https://cloud.reown.com) — required by ConnectKit
# WalletConnect Cloud project id (https://cloud.reown.com) — empty = MetaMask-only; set to enable other wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=
# Fanhatch contract addresses (see fanhatch-contracts/deployments/ethereum-sepolia)
NEXT_PUBLIC_FANS_ADDRESS=
NEXT_PUBLIC_CLUB_FACTORY_ADDRESS=
NEXT_PUBLIC_FANS_SWAP_ADDRESS=
NEXT_PUBLIC_FEE_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_STAKING_FANS_ADDRESS=
NEXT_PUBLIC_STAKING_LP_ADDRESS=0xF4A8F3c8ac866551B1aAa78cF19C238D7243BC3b
NEXT_PUBLIC_CLUB_KEY_BEACON_ADDRESS=

# --- Uniswap v4 (Sepolia) — swap via router, LP via vault ---
NEXT_PUBLIC_POOL_MANAGER_ADDRESS=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
NEXT_PUBLIC_FANS_HOOK_ADDRESS=0xB2015C1c323d22D68E06042EB9A70a3b4f7760CC
NEXT_PUBLIC_FANS_V4_ROUTER_ADDRESS=0x19dbb0CBbf6910D39a6513f36E8CDC418f586545
NEXT_PUBLIC_FANS_LP_VAULT_ADDRESS=0x96bC0735c79666a68d779584974e1F93F42F0Df9
